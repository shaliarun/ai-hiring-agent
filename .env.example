# ════════════════════════════════════════════════════════════════════
#  AI Hiring Agent — Environment Variables
#  Copy this file to artifacts/api-server/.env and fill in the values.
#  The frontend (Vercel) uses VITE_* variables set in the Vercel dashboard.
# ════════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────
# Use your Supabase (or any Postgres) connection string
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=postgresql://user:password@localhost:5432/hiring_agent

# ── Auth ────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-string

# ── Email (Gmail SMTP) ──────────────────────────────────────────────
# Use your Gmail address + an App Password (not your main password).
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Google OAuth (Gmail Import) ─────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/gmail/callback

# ── CORS (production) ───────────────────────────────────────────────
# Comma-separated allowed origins for the API server in production.
# Add your Vercel URL here: https://your-app.vercel.app
ALLOWED_ORIGINS=

# ── Frontend (Vercel env vars — set in Vercel dashboard, not here) ──
# VITE_API_URL=https://your-deployed-api-server.com
