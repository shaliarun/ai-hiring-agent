# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/hiring_agent

# ── Auth ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-string

# ── OpenAI (AI Resume Screening) ──────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Google OAuth (Gmail Import + Drive Backup) ────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/gmail/callback

# ── Custom User Accounts (optional) ──────────────────────────────────────
# Override the default login accounts. Format: JSON array.
# HIRING_USERS=[{"username":"hr@acme.com","password":"Pass@123","role":"HR","name":"HR Admin"},{"username":"mgr@acme.com","password":"Pass@123","role":"Manager","name":"John Manager"}]
