# ════════════════════════════════════════════════════════════════════
#  AI Hiring Agent — Environment Variables
#
#  LOCAL DEVELOPMENT:
#    Copy this file to artifacts/api-server/.env and fill in values.
#
#  VERCEL DEPLOYMENT (frontend + backend both on Vercel):
#    Set the variables below in Vercel Dashboard → Settings → Environment Variables.
#    Do NOT set VITE_API_URL — frontend and backend share the same domain.
# ════════════════════════════════════════════════════════════════════

# ── Database (Supabase) ─────────────────────────────────────────────
# Your Supabase connection string (use the pooler URL, port 6543)
SUPABASE_DATABASE_URL=postgresql://user:password@host:6543/postgres

# ── Auth ────────────────────────────────────────────────────────────
# Any long random string — used to sign JWT tokens
SESSION_SECRET=change-this-to-a-long-random-string

# ── Email (Gmail SMTP) ──────────────────────────────────────────────
# Your Gmail address and a Gmail App Password (not your main password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Google OAuth (Gmail Resume Import — optional) ───────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Redirect URI for Vercel: https://your-app.vercel.app/api/gmail/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/gmail/callback

# ── CORS ────────────────────────────────────────────────────────────
# Not needed on Vercel (frontend and API share the same domain).
# Only set this if you host the API separately from the frontend.
# ALLOWED_ORIGINS=https://your-other-frontend.vercel.app

# ── Local dev only (not needed on Vercel) ───────────────────────────
PORT=8080
NODE_ENV=development
