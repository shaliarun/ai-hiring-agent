# ── Server ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Use your Supabase (or any Postgres) connection string
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname
# Fallback Postgres URL (used if SUPABASE_DATABASE_URL is not set)
# DATABASE_URL=postgresql://user:password@localhost:5432/hiring_agent

# ── Auth ────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-string

# OpenAI (AI Screening)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Email (Gmail SMTP) ──────────────────────────────────────────────────────
# Use your Gmail address and an App Password (not your main password).
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Google OAuth (Gmail Import) ─────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/gmail/callback

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins in production.
# Example: https://your-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=

# ── Custom User Accounts (optional) ─────────────────────────────────────────
# Override default login accounts. Format: JSON array.
# HIRING_USERS=[{"username":"hr@acme.com","password":"Pass@123","role":"HR","name":"HR Admin"}]
